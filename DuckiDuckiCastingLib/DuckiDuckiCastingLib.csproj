<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
	<Nullable>enable</Nullable>
	<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	<LangVersion>11</LangVersion>
    <PackageId>DuckiDuckiCastingLib</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Roslyn source generators for duck typing and JSON-driven POCO classes.</Description>
    <RepositoryUrl>https://github.com/GatheredSatyr53/DuckiDuckiCastingLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DuckiDuckiCastingLib.Tests" />
    <None Include="../DuckiDuckiSampleProject/PocoJson/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="IncludeAnalyzerInPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

</Project>
